{
  "name": "marieta-mawe-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo de imprimibles y kits de Marieta",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
